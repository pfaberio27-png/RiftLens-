# Copia este archivo como backend/.env y completa los valores.

# Riot Games API (https://developer.riotgames.com)
RIOT_API_KEY=

# Partidas a analizar: Ranked Solo/Dúo desde esta fecha (AAAA-MM-DD, UTC)
TEMPORADA_INICIO=2026-01-08

# Límites de Riot API: solicitudes:segundos, separados por comas
RIOT_LIMITES=20:1,100:120

# SQL Server (true = usar la base como caché; false = usar partidas.json)
DB_ENABLED=false
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=RiftLensDB
DB_DRIVER=ODBC Driver 17 for SQL Server
